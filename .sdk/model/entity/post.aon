# Entity: post

main: kit: entity: post: {

  alias: field: {}

  fields: [
    {
      name: "content"
      req: false
      short: "Post content in Korean"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "createdAt"
      req: false
      short: "Post creation timestamp"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Post ID"
      type: "`$INTEGER`"
    }
    {
      name: "title"
      req: false
      short: "Post title in Korean"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "updatedAt"
      req: false
      short: "Post last update timestamp"
      type: "`$STRING`"
    }
    {
      name: "userId"
      req: false
      short: "User ID who created the post"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "post"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/posts"
          segments: [
            {
              lit: "posts"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "user_id"
                orig: "user_id"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/posts"
          segments: [
            {
              lit: "posts"
            }
          ]
          select: {
            exist: [
              "user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/posts/{id}"
          segments: [
            {
              lit: "posts"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "DELETE"
          orig: "/posts/{id}"
          segments: [
            {
              lit: "posts"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "PUT"
          orig: "/posts/{id}"
          segments: [
            {
              lit: "posts"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
